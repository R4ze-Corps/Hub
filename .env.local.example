# Copie este arquivo para .env.local e preencha os valores.
# Não compartilhe nem versione o .env.local.

# MongoDB
MONGODB_URI="YOUR_MONGODB_CONNECTION_STRING"

# Login com Discord — Discord Developer Portal > OAuth2
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# URL de retorno: deverá corresponder à rota implementada no servidor
# e à URL cadastrada em OAuth2 > Redirects no Discord.
DISCORD_REDIRECT_URI="http://localhost:3000/api/auth/callback/discord"

# Login implementado com NextAuth. A URL de retorno precisa estar cadastrada no Discord.

# Sessão do login (não reutilize o Client Secret do Discord)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Seu ID de usuário Discord; vazio mantém todos como clientes
OWNER_DISCORD_ID=""
